---
import "./style.css";
import "./projects.css";

interface Fact {
  lead?: { label: string; href: string };
  text: string;
}

interface Project {
  name: string;
  description: string;
  facts: Fact[];
  tags: string[];
  links: { label: string; href: string }[];
}

const projects: Project[] = [
  {
    name: "Q7 Chat",
    description:
      "A private messenger that runs entirely in the browser. No accounts, no server, and every message disappears after 72 hours.",
    facts: [
      { text: "End-to-end encrypted, peer-to-peer over WebRTC" },
      { text: "Encrypted relay fallback through public MQTT brokers" },
      { text: "Chats and keys stay on your device in IndexedDB" },
    ],
    tags: ["Next.js", "TypeScript", "Tailwind CSS", "WebRTC"],
    links: [
      { label: "GitHub", href: "https://github.com/q7xk/q7-chat" },
      { label: "Live", href: "https://ms-q7xk.vercel.app" },
    ],
  },
  {
    name: "Nexus Linux",
    description:
      "An independent open-source Linux distribution aiming for a modern, reliable and user-friendly desktop.",
    facts: [
      {
        lead: { label: "nexsolv", href: "https://github.com/Nexus-Linux-Official/nexsolv" },
        text: ", a dependency solver in C",
      },
      {
        lead: { label: "nexus-rust-tools", href: "https://github.com/Nexus-Linux-Official/nexus-rust-tools" },
        text: ", written in Rust",
      },
      {
        lead: { label: "nexus-iso", href: "https://github.com/Nexus-Linux-Official/nexus-iso" },
        text: ", written in Shell",
      },
    ],
    tags: ["Linux", "C", "Rust", "Shell"],
    links: [{ label: "GitHub", href: "https://github.com/Nexus-Linux-Official" }],
  },
];

const title = "My Projects";
---

<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · q7xk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="https://avatars.githubusercontent.com/u/292994106?v=4" />
  </head>
  <body class="projects">
    <canvas id="c"></canvas>
    <div class="veil"></div>

    <main class="page">
      <a class="back" href="/">Home</a>
      <h1 class="page-title">{title}</h1>

      <div class="grid">
        {projects.map((p) => (
          <article class="card">
            <h2>{p.name}</h2>
            <p class="desc">{p.description}</p>
            <ul class="facts">
              {p.facts.map((f) => (
                <li>
                  {f.lead && (
                    <a href={f.lead.href} target="_blank" rel="noopener noreferrer">{f.lead.label}</a>
                  )}
                  {f.text}
                </li>
              ))}
            </ul>
            <ul class="tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
            <div class="card-links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </main>

    <script src="./script.js"></script>
  </body>
</html>
